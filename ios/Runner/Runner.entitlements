<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- "Near Field Communication Tag Reading" capability. flutter_nfc_kit
	     NFCTagReaderSession kullandığı için TAG formatı şart; bu anahtar
	     olmadan iOS oturumu açılmadan uygulamayı sonlandırıyor. -->
	<!-- Paylaşılan haber ve etkinlik bağlantıları (Universal Links).
	     Doğrulama https://app.yildizskylab.com/.well-known/apple-app-site-association
	     üzerinden; Apple Developer hesabında Associated Domains açık olmalı. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:app.yildizskylab.com</string>
	</array>
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
</dict>
</plist>
